#!/usr/bin/env bash
# Runs the full gate before anything leaves the machine. Skip once with `git push --no-verify`.
#
# This replaces two scripts that no longer exist, scripts/check.sh and scripts/check-website.sh,
# which were folded into `just check` when the workspace split.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v just >/dev/null; then
  echo "pre-push: just not installed, skipping the gate (see https://just.systems)"
  exit 0
fi

echo "pre-push: just check"
just check
