#!/usr/bin/env bash
# Runs the full gate before pushing. Skip once with git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v just >/dev/null; then
  echo "pre-push: just not installed, skipping the gate (see https://just.systems)"
  exit 0
fi

echo "pre-push: just check"
just check
