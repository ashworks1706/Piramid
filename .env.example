# Piramid configuration.
# Copy to .env (`just env`). Every value here is a default — delete a line to use it.
# A YAML/JSON file via CONFIG_FILE is loaded first; these variables override it.
# Secrets stay blank in this file and are never committed.

# ---------- server ----------
PORT=6333
DATA_DIR=~/.piramid
# CONFIG_FILE=piramid.yaml

# ---------- logging ----------
# error | warn | info | debug | trace
LOG_LEVEL=info
# Per-subsystem toggles: piramid::{config,indexing,search,writes,inference,http}
LOG_INDEXING=true
LOG_SEARCH=true
LOG_WRITES=true
LOG_INFERENCE=true
LOG_HTTP=true
# Structured JSON lines instead of readable console output — set this wherever logs are shipped
LOG_JSON=false
# Queries slower than this are logged at warn
SLOW_QUERY_MS=500
# Standard tracing filter, applied on top of the above
# RUST_LOG=piramid=debug

# ---------- execution ----------
# auto | scalar | simd | parallel | binary | gpu
# `gpu` requires a build with --features gpu-cuda; it falls back to CPU with a
# warning if no device is found.
EXECUTION_MODE=auto
PARALLEL_SEARCH=false
# NUM_THREADS=0            # 0 = all cores

# ---------- hardware ----------
# auto | cpu-only | gpu | memory-8gb | memory-16gb
HARDWARE_PROFILE=auto
HARDWARE_GPU_ENABLED=false
# HARDWARE_CPU_THREADS=8
# HARDWARE_MEMORY_BUDGET_BYTES=8589934592

# ---------- index ----------
# auto | flat | hnsw | ivf
INDEX_TYPE=auto
INDEX_AUTO_FLAT_MAX_VECTORS=10000
INDEX_AUTO_IVF_MAX_VECTORS=100000
INDEX_AUTO_IVF_MAX_ITERATIONS=10
# INDEX_AUTO_IVF_NUM_CLUSTERS=
# INDEX_AUTO_IVF_NUM_PROBES=
INDEX_AUTO_HNSW_M=16
INDEX_AUTO_HNSW_EF_CONSTRUCTION=200
INDEX_AUTO_HNSW_EF_SEARCH=200

# ---------- search ----------
# Candidates fetched per k when a metadata filter is present
SEARCH_FILTER_OVERFETCH=4
SEARCH_ADAPTIVE_ENABLED=false
# SEARCH_LATENCY_BUDGET_MS=
# SEARCH_RECALL_TARGET=

# ---------- cache ----------
CACHE_ENABLED=true
# CACHE_MAX_SIZE=
# CACHE_MAX_BYTES=
# CACHE_TTL_SECONDS=

# ---------- storage and durability ----------
MEMORY_USE_MMAP=true
MEMORY_INITIAL_MMAP_MB=64
WAL_ENABLED=true
WAL_CHECKPOINT_FREQUENCY=1000
# WAL_CHECKPOINT_INTERVAL_SECS=
# Refuse writes (or drop to read-only) below this much free disk
# DISK_MIN_FREE_BYTES=
DISK_READONLY_ON_LOW_SPACE=true

# ---------- limits ----------
# LIMIT_MAX_VECTORS=
# LIMIT_MAX_BYTES=
# LIMIT_MAX_VECTOR_BYTES=

# ---------- quantization ----------
# none | int8 | pq
QUANTIZATION_STAGE=none
QUANTIZATION_STORAGE_ENABLED=false
QUANTIZATION_INDEX_ENABLED=false
QUANTIZATION_QUERY_ENABLED=false
QUANTIZATION_RESULT_ENABLED=false
QUANTIZATION_PRESERVE_RAW=true

# ---------- embeddings ----------
# openai | ollama | local — unset disables the /embed endpoints
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
# EMBEDDING_TIMEOUT_SECS=30
# Secret — leave blank here, set it in .env
OPENAI_API_KEY=

# ---------- observability (optional) ----------
# OTLP endpoint for traces; unset disables the exporter
# PIRAMID_OTLP_ENDPOINT=http://localhost:4317
# PIRAMID_OTLP_SERVICE_NAME=piramid
# Sentry DSN for errors and panics; unset disables Sentry
# PIRAMID_SENTRY_DSN=
# PIRAMID_SENTRY_ENVIRONMENT=development
# PIRAMID_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- deploy ----------
# Image tag used by deploy/compose.prod.yml
PIRAMID_IMAGE_TAG=main
